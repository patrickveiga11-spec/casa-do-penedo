DATABASE_URL="postgresql://casa:casa@localhost:5432/casa_do_penedo?schema=public"
API_PORT=3001
VITE_API_URL=http://localhost:3001

# Brevo — opção mais simples (recomendada)
# Settings → SMTP & API → API Keys → Create API key
BREVO_API_KEY=

# Brevo SMTP (alternativa / fallback externo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Casa do Penedo <casa_do_penedo@casadopenedo.pt>"
OWNER_EMAIL=casa_do_penedo@casadopenedo.pt
# Destino oficial de gestão (sempre o email do domínio)
OWNER_NOTIFICATION_EMAILS=casa_do_penedo@casadopenedo.pt
BREVO_SENDER_EMAIL=casa_do_penedo@casadopenedo.pt

# SMTP do alojamento (cPanel) — OBRIGATÓRIO para notificar @casadopenedo.pt
# (o MX rejeita IPs da Brevo / SpamCop RBL)
DOMAIN_SMTP_HOST=webdomain03.dnscpanel.com
DOMAIN_SMTP_PORT=587
DOMAIN_SMTP_USER=casa_do_penedo@casadopenedo.pt
DOMAIN_SMTP_PASS=

# Password da área de gestão (/gestao) — escolhe uma password forte
ADMIN_PASSWORD=

# Produção (Render): usa PORT automático; não precisas de API_PORT
# Produção (Vercel): VITE_API_URL=https://a-tua-api.onrender.com
