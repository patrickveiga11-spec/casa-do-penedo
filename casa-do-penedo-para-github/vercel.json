{
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/gestao", "destination": "/gestao.html" },
    { "source": "/gestao/(.*)", "destination": "/gestao.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/welcome-emails",
      "schedule": "0 8 * * *"
    }
  ]
}
